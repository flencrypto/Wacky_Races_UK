# Database
DATABASE_URL=postgresql://postgres:password@db:5432/wackraces

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=change-me-strong-jwt-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-strong-refresh-secret-min-32

# API
PORT=3000
NODE_ENV=development

# Frontend
VITE_DEFAULT_EVENT_ID=00000000-0000-0000-0000-000000000000
VITE_MAP_STYLE_URL=https://demotiles.maplibre.org/style.json
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
VITE_PWA_ENABLED=true

# Postgres credentials (for Docker)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# Agents
AGENTS_API_BASE_URL=http://api:3000
AGENTS_USE_DOCKER=false
AGENTS_STATUS_PORT=4000
AGENTS_OPS_INTERVAL_MS=15000
AGENTS_HEARTBEAT_INTERVAL_MS=10000
AGENTS_HEARTBEAT_TIMEOUT_SEC=45
AGENTS_DEBUG_SECRET=change-me-strong-debug-secret-min-32
# Comma-separated list of Docker service names that may be debugged (default: api,processor,web,nginx,agents,db,redis)
# AGENTS_ALLOWED_SERVICES=api,processor,web,nginx,agents,db,redis
